# xxl-job-executor-http 环境变量样例。复制为 .env 并填实际值（.env 已 gitignore）。
# 部署时整文件放到节点 /data/xxl-job-executor-http/.env（chmod 600），systemd 单元用 EnvironmentFile= 加载。

LOG_HOME=/data/xxl-job-executor-http/logs
JAVA_OPTS=-Xms128m -Xmx256m -Duser.timezone=Asia/Tokyo -Dfile.encoding=UTF-8

# 调度中心地址：生产用 Internal Gateway 内网域名，可在后面追加实例直连地址作兜底（逗号分隔，按顺序尝试）
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job.internal.sentino.jp

# 调度中心"执行器管理"里对应执行器组的 AppName 与 AccessToken
XXL_JOB_EXECUTOR_APPNAME=http-executor
XXL_JOB_EXECUTOR_ACCESS_TOKEN=

# 内嵌端口与注册地址；ADDRESS 须是调度中心可达的本机私网 ip:port，容器 / 多网卡环境必填
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_EXECUTOR_ADDRESS=
XXL_JOB_EXECUTOR_LOGPATH=/data/xxl-job-executor-http/logs/jobhandler

# httpJobHandler 允许请求的目标，逗号分隔：host、host:port、.example.com（任意子域）或 URL 前缀。留空 = 全部允许，生产必填。
XXL_JOB_HTTPJOB_ALLOWDOMAINS=
