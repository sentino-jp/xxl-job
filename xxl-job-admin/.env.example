# xxl-job-admin 环境变量样例。复制为 .env 并填实际值（.env 已 gitignore）。
# 本地起服务前：set -a && . ./.env && set +a
# 部署时整文件放到节点 /data/xxl-job-admin/.env（chmod 600），systemd 单元用 EnvironmentFile= 加载。
# 变量名与 coucou-server 保持一致（DB_URL / DB_USER / DB_PASSWORD），application.properties 里对应 ${ENV:默认值} 占位。
# ⚠️ 值里含空格或 shell 特殊字符（如 JAVA_OPTS、密码里的 ! ^ * % $）必须加引号：start.sh 是用 bash source 读的，
#    不加引号会把空格后面的内容当命令执行；systemd EnvironmentFile 同样接受引号，两边通用。密码建议用单引号。

# ── 进程 ──
SERVER_PORT=9280
LOG_HOME=/data/xxl-job-admin/logs
JAVA_OPTS="-Xms512m -Xmx1g -XX:+UseG1GC -Duser.timezone=Asia/Tokyo -Dfile.encoding=UTF-8"

# ── 数据库（PostgreSQL；独立 xxl_job 库 + 独立账号，多台调度中心共用同一个库）──
DB_URL=jdbc:postgresql://localhost:5432/xxl_job
DB_USER=xxl_job
DB_PASSWORD=

# ── Lark / 飞书告警（自定义机器人）。留空 = 通道 no-op，不影响调度与邮件告警。URL 即凭证，勿入库。──
XXL_JOB_LARK_WEBHOOK_URL=
# 仅当机器人开启「签名校验」时需要
XXL_JOB_LARK_SECRET=
# 环境标识（prod / stage / local），作为消息前缀
XXL_JOB_LARK_ENV=
# 同一任务在窗口内只告警一次，其余累计并在下次说明
XXL_JOB_LARK_SUPPRESS_SECONDS=300
# 调度中心对外地址，用于告警消息里的执行日志链接
XXL_JOB_LARK_ADMIN_URL=http://xxl-job.internal.sentino.jp

# ── 邮件告警（可选；留空即不发邮件，按任务的"报警邮箱"字段发送）──
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=

# ── 调度参数（默认值一般不用改）──
XXL_JOB_I18N=zh_CN
XXL_JOB_LOG_RETENTION_DAYS=30
#XXL_JOB_TRIGGERPOOL_FAST_MAX=300
#XXL_JOB_TRIGGERPOOL_SLOW_MAX=200

# ── 内嵌通用 HTTP 执行器（原 xxl-job-executor-http 模块已并入调度中心进程；每台调度中心即一个 http-executor 实例）──
# 关掉某台节点的执行器只做调度：XXL_JOB_EXECUTOR_ENABLED=false
XXL_JOB_EXECUTOR_ENABLED=true
# 调度中心"执行器管理"里对应执行器组的 AppName 与 AccessToken（建组生成后填入，三台滚动重启）
XXL_JOB_EXECUTOR_APPNAME=http-executor
XXL_JOB_EXECUTOR_ACCESS_TOKEN=
# 内嵌执行器端口；须在安全组内对其余调度中心节点放通。ADDRESS 留空则自动取本机 ip:port，多网卡 / 容器环境填 http://<私网IP>:9999/
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_EXECUTOR_ADDRESS=
# 任务日志目录，默认 ${LOG_HOME}/xxl-job/jobhandler
#XXL_JOB_EXECUTOR_LOGPATH=
# httpJobHandler 允许请求的目标，逗号分隔：host、host:port、.example.com（任意子域）或 URL 前缀。留空 = 全部允许，生产必填。
XXL_JOB_HTTPJOB_ALLOWDOMAINS=
