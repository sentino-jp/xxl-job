# /data/xxl-job-admin/.env  —  systemd EnvironmentFile for xxl-job-admin
# Copy to /data/xxl-job-admin/.env, fill the values, chmod 600. Never commit the real file.
# Spring Boot maps SPRING_DATASOURCE_URL -> spring.datasource.url etc. automatically (relaxed binding).

# ---- process ----
SERVER_PORT=8080
LOG_HOME=/data/xxl-job-admin/logs
JAVA_OPTS=-Xms512m -Xmx1g -XX:+UseG1GC -Duser.timezone=Asia/Tokyo -Dfile.encoding=UTF-8

# ---- database (PostgreSQL, one database shared by all admin instances) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://10.0.1.34:5432/xxl_job?sslmode=require
SPRING_DATASOURCE_USERNAME=xxl_job
SPRING_DATASOURCE_PASSWORD=__FILL_ME__

# ---- lark (feishu) alarm: custom bot webhook. leave WEBHOOK_URL empty to disable the channel ----
XXL_JOB_LARK_WEBHOOK_URL=__FILL_ME__
XXL_JOB_LARK_SECRET=__FILL_ME__
XXL_JOB_LARK_ENV=prod
XXL_JOB_LARK_SUPPRESS_SECONDS=300
# public url of this scheduler center, used for the log link inside alarm messages
XXL_JOB_LARK_ADMIN_URL=https://xxl-job.example.com

# ---- email alarm (optional; leave as is if only lark is used) ----
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=465
#SPRING_MAIL_USERNAME=alarm@example.com
#SPRING_MAIL_FROM=alarm@example.com
#SPRING_MAIL_PASSWORD=__FILL_ME__

# ---- scheduler tuning (defaults are fine for hundreds of jobs) ----
#XXL_JOB_TRIGGERPOOL_FAST_MAX=300
#XXL_JOB_TRIGGERPOOL_SLOW_MAX=200
#XXL_JOB_LOGRETENTIONDAYS=30
