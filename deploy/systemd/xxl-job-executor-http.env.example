# /data/xxl-job-executor-http/.env  —  systemd EnvironmentFile for the generic HTTP executor
# Copy to /data/xxl-job-executor-http/.env, fill the values, chmod 600. Never commit the real file.

LOG_HOME=/data/xxl-job-executor-http/logs
JAVA_OPTS=-Xms128m -Xmx256m -Duser.timezone=Asia/Tokyo -Dfile.encoding=UTF-8

# scheduler center address (load balancer or comma separated instance list)
XXL_JOB_ADMIN_ADDRESSES=http://10.0.1.20:8080,http://10.0.1.21:8080

# executor group in the scheduler console and its access token
XXL_JOB_EXECUTOR_APPNAME=http-executor
XXL_JOB_EXECUTOR_ACCESS_TOKEN=__FILL_ME__

# embedded port the scheduler calls back on; ADDRESS must be reachable from the scheduler center (private ip:port)
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_EXECUTOR_ADDRESS=http://10.0.1.30:9999/
XXL_JOB_EXECUTOR_LOGPATH=/data/xxl-job-executor-http/logs/jobhandler

# allowed target hosts for httpJobHandler (comma separated: host, host:port, .example.com, or URL prefix). Always set in production.
XXL_JOB_HTTPJOB_ALLOWDOMAINS=.sentino.jp,api.coucou.fun,10.0.1.34:9082
